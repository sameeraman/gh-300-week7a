{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "api/src",
    "outDir": "dist",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["api/src/**/*.ts"],
  "exclude": ["api/src/tests/**"]
}
